# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Alternative acceptée : DB_USERNAME (TiDB Cloud, etc.)
DB_PASSWORD=
DB_DATABASE=consolation_pharma
# Obligatoire pour TiDB Cloud (activé auto si le host contient tidbcloud.com)
DB_SSL=true
